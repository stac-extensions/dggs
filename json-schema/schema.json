{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stac-extensions.github.io/dggs/v0.1.0/schema.json#",
  "title": "DGGS Extension",
  "description": "STAC DGGS Extension for STAC Items and STAC Collections.",
  "oneOf": [
    {
      "$comment": "This is the schema for STAC Items.",
      "allOf": [
        {
          "$ref": "#/definitions/stac_extensions"
        },
        {
          "type": "object",
          "required": [
            "type",
            "properties",
            "assets"
          ],
          "properties": {
            "type": {
              "const": "Feature"
            },
            "properties": {
              "$ref": "#/definitions/fields_and_dimensions"
            },
            "assets": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/fields_and_dimensions"
              }
            }
          }
        }
      ]
    },
    {
      "$comment": "This is the schema for STAC Collections.",
      "allOf": [
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "Collection"
            },
            "assets": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/fields_and_dimensions"
              }
            },
            "item_assets": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/fields_and_dimensions"
              }
            }
          }
        },
        {
          "$ref": "#/definitions/stac_extensions"
        },
        {
          "$ref": "#/definitions/fields_and_dimensions"
        }
      ]
    }
  ],
  "definitions": {
    "stac_extensions": {
      "type": "object",
      "required": [
        "stac_extensions"
      ],
      "properties": {
        "stac_extensions": {
          "type": "array",
          "contains": {
            "const": "https://stac-extensions.github.io/dggs/v0.1.0/schema.json"
          }
        }
      }
    },
    "fields_and_dimensions": {
      "allOf": [
        {
          "$ref": "#/definitions/fields"
        },
        {
          "$ref": "#/definitions/datacube_dimensions"
        }
      ]
    },
    "datacube_dimensions": {
      "$comment": "Validates the fields in data cube dimensions of type dggs.",
      "type": "object",
      "properties": {
        "cube:dimensions": {
          "type": "object",
          "additionalProperties": {
            "if": {
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "const": "dggs"
                }
              }
            },
            "then": {
              "$ref": "#/definitions/fields"
            }
          }
        }
      }
    },
    "fields": {
      "type": "object",
      "properties": {
        "dggs:dggrs": {
          "type": "string",
          "minLength": 1
        },
        "dggs:refinement_level": {
          "type": "integer",
          "minimum": 0
        },
        "dggs:indexing_scheme": {
          "type": "string",
          "minLength": 1
        },
        "dggs:zone_id": {
          "type": "string",
          "minLength": 1
        },
        "dggs:zone_level": {
          "type": "integer",
          "minimum": 0
        }
      },
      "patternProperties": {
        "^(?!dggs:)": {}
      },
      "additionalProperties": false
    }
  }
}
